# =============================================
# Aisha Events Centre — Environment Variables
# =============================================

# Supabase — get these from your Supabase project dashboard
# Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Paystack — get these from your Paystack dashboard
# Settings > API Keys & Webhooks
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
VITE_PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
